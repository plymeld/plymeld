# The conventions the code already follows, for editors that read this file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = unset

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
